{
  "name": "hugo-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace apps/server",
    "dev:backend:watch": "npm run dev --workspace apps/server",
    "build": "npm run --workspace apps/web build && node scripts/generate-seo.mjs",
    "build:analyze": "npm run --workspace apps/web build:analyze",
    "check:seo": "node scripts/checks/check-seo.mjs",
    "check:performance": "node scripts/checks/check-performance-budget.mjs",
    "ci:seo": "npm run build && npm run check:seo",
    "ci:performance": "npm run build && npm run check:performance",
    "lint": "eslint apps/web/src apps/server scripts apps/workers",
    "preview": "npm run --workspace apps/web preview",
    "setup": "npm install",
    "check:api-auth": "node scripts/checks/check-api-auth.mjs",
    "check:coder-content": "node scripts/checks/check-coder-content.mjs",
    "check:all": "node scripts/checks/run-all-checks.mjs",
    "build:native": "npm run --workspace apps/web build:native",
    "native:sync": "npm run --workspace apps/web native:sync",
    "native:ios": "npm run --workspace apps/web native:ios",
    "native:android": "npm run --workspace apps/web native:android",
    "cv:pdf": "node scripts/export-cv-pdfs.mjs",
    "cv:pdf:vi": "node scripts/export-cv-pdfs.mjs vi",
    "cv:pdf:en": "node scripts/export-cv-pdfs.mjs en",
    "cv:pdf:ats": "node scripts/export-cv-pdfs.mjs ats",
    "check:imports": "node scripts/checks/check-tracked-imports.mjs",
    "check:today": "node apps/server/scripts/check-today-feed.mjs",
    "ota:bundle": "node scripts/ota-bundle.mjs",
    "dev:frontend": "npm run --workspace apps/web dev",
    "check:exam": "node apps/server/scripts/check-exam-flow.mjs",
    "check:grading": "node apps/server/scripts/check-stage-grading.mjs",
    "gen:nginx": "node apps/server/scripts/gen-nginx.mjs",
    "check:gateway": "node apps/server/scripts/check-gateway.mjs",
    "check:guards": "node apps/server/scripts/check-route-guards.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check:csp": "node scripts/checks/check-csp.mjs",
    "check:telegram": "node apps/server/scripts/check-telegram-bot.mjs",
    "migrate:bio-expiry-index": "node apps/server/scripts/migrate-bio-expiry-index.mjs",
    "check:money": "node apps/server/scripts/check-money-stepup.mjs",
    "cv:pdf:zh": "node scripts/export-cv-pdfs.mjs zh",
    "cv:pdf:ats-en": "node scripts/export-cv-pdfs.mjs ats-en",
    "check:cv": "python3 scripts/checks/check-cv-ats.py",
    "check:psy": "python3 scripts/checks/check-hugopsy.py && node scripts/checks/check-hugopsy-node.mjs",
    "check:project": "node scripts/checks/check-project-workflow.mjs",
    "check:wallet-auth": "node apps/server/scripts/check-wallet-auth.mjs",
    "check:app-standard": "node scripts/checks/check-app-standard.mjs",
    "joy:audit": "node apps/server/scripts/joy-audit.mjs",
    "check:transfer-caps": "node apps/server/scripts/check-transfer-caps.mjs",
    "check:notification-source": "node apps/server/scripts/check-notification-source.mjs",
    "check:notification-tone": "node apps/server/scripts/check-notification-tone.mjs",
    "check:survey": "node apps/server/scripts/check-survey.mjs",
    "check:tier-finance": "node apps/server/scripts/check-tier-finance.mjs",
    "check:han-viet": "node scripts/checks/check-han-viet.mjs",
    "check:sino": "node apps/server/scripts/check-sino-numerals.mjs",
    "build:nom-font": "node scripts/build-nom-font.mjs",
    "build:nom": "node scripts/build-nom-locale.mjs",
    "build:nom-lessons": "node scripts/build-nom-lessons.mjs",
    "build:nom-ui": "node scripts/build-nom-ui.mjs",
    "check:nom": "node scripts/checks/check-nom.mjs",
    "check:joy-stability": "node apps/server/scripts/check-joy-stability.mjs",
    "joy:recall": "node apps/server/scripts/joy-recall.mjs",
    "joy:report": "node -e \"import('./apps/server/services/joyStabilityService.js').then(m=>m.sendWeeklyReport({force:true}).then(r=>console.log(r)))\"",
    "dev:portfolio": "npm run --workspace apps/web dev:portfolio",
    "build:portfolio": "npm run --workspace apps/web build:portfolio && node scripts/generate-portfolio-seo.mjs",
    "preview:portfolio": "npm run --workspace apps/web preview:portfolio",
    "check:seo:portfolio": "SITE_TARGET=portfolio node scripts/checks/check-seo.mjs",
    "deploy:portfolio": "node scripts/deploy-portfolio.mjs",
    "og:partner": "node scripts/generate-partner-og.mjs"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "globals": "^17.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1"
  },
  "overrides": {
    "query-string": "^9.5.1"
  }
}
