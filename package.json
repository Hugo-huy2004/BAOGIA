{
  "name": "hugo-wishpax-portal",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "cd server && PORT=${PORT:-8099} npm run dev",
    "dev:backend:watch": "cd server && PORT=${PORT:-8099} npm run dev",
    "build": "vite build && node scripts/generate-seo.mjs",
    "build:analyze": "ANALYZE=1 vite build",
    "check:seo": "node scripts/checks/check-seo.mjs",
    "check:performance": "node scripts/checks/check-performance-budget.mjs",
    "ci:seo": "npm run build && npm run check:seo",
    "ci:performance": "npm run build && npm run check:performance",
    "lint": "eslint src server scripts workers",
    "preview": "vite preview",
    "server:install": "cd server && npm install",
    "setup": "npm install && npm run server:install",
    "check:api-auth": "node scripts/checks/check-api-auth.mjs",
    "check:coder-content": "node scripts/checks/check-coder-content.mjs",
    "check:all": "node scripts/checks/run-all-checks.mjs",
    "build:native": "VITE_BUILD_TARGET=native vite build --outDir dist-native",
    "native:sync": "VITE_API_URL=https://api.hugowishpax.studio/api npm run build:native && npx cap sync",
    "native:ios": "npm run native:sync && npx cap open ios",
    "native:android": "npm run native:sync && npx cap open android",
    "cv:pdf": "node scripts/export-cv-pdfs.mjs",
    "cv:pdf:vi": "node scripts/export-cv-pdfs.mjs vi",
    "cv:pdf:en": "node scripts/export-cv-pdfs.mjs en",
    "cv:pdf:ats": "node scripts/export-cv-pdfs.mjs ats",
    "check:imports": "node scripts/checks/check-tracked-imports.mjs",
    "check:today": "node server/scripts/check-today-feed.mjs",
    "ota:bundle": "node scripts/ota-bundle.mjs",
    "dev:frontend": "vite",
    "check:reading": "cd server && node scripts/check-reading-gate.mjs",
    "check:exam": "cd server && node scripts/check-exam-flow.mjs",
    "check:grading": "cd server && node scripts/check-stage-grading.mjs",
    "gen:nginx": "node server/scripts/gen-nginx.mjs",
    "check:gateway": "node server/scripts/check-gateway.mjs",
    "check:catalog": "cd server && node scripts/check-course-catalog.mjs",
    "check:guards": "node server/scripts/check-route-guards.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=high && npm audit --omit=dev --audit-level=high --prefix server",
    "check:csp": "node scripts/checks/check-csp.mjs",
    "check:admin-auth": "node server/scripts/check-admin-auth.mjs",
    "check:telegram": "node server/scripts/check-telegram-bot.mjs",
    "check:money": "node server/scripts/check-money-stepup.mjs",
    "cv:pdf:zh": "node scripts/export-cv-pdfs.mjs zh",
    "cv:pdf:ats-en": "node scripts/export-cv-pdfs.mjs ats-en",
    "check:cv": "python3 scripts/checks/check-cv-ats.py",
    "check:psy": "python3 scripts/checks/check-hugopsy.py && node scripts/checks/check-hugopsy-node.mjs",
    "check:project": "node scripts/checks/check-project-workflow.mjs",
    "check:wallet-auth": "node server/scripts/check-wallet-auth.mjs",
    "check:app-standard": "node scripts/checks/check-app-standard.mjs",
    "joy:audit": "node server/scripts/joy-audit.mjs",
    "check:transfer-caps": "node server/scripts/check-transfer-caps.mjs",
    "check:notification-source": "node server/scripts/check-notification-source.mjs",
    "check:notification-tone": "node server/scripts/check-notification-tone.mjs",
    "check:survey": "node server/scripts/check-survey.mjs",
    "check:joylater-policy": "node server/scripts/check-joylater-policy.mjs",
    "check:joylater-rates": "node server/scripts/check-joylater-rates.mjs",
    "check:tier-finance": "node server/scripts/check-tier-finance.mjs",
    "check:han-viet": "node scripts/checks/check-han-viet.mjs",
    "check:sino": "node server/scripts/check-sino-numerals.mjs",
    "build:nom-font": "node scripts/build-nom-font.mjs",
    "build:nom": "node scripts/build-nom-locale.mjs",
    "build:nom-lessons": "node scripts/build-nom-lessons.mjs",
    "build:nom-ui": "node scripts/build-nom-ui.mjs",
    "check:nom": "node scripts/checks/check-nom.mjs",
    "check:joy-stability": "node server/scripts/check-joy-stability.mjs",
    "joy:recall": "node server/scripts/joy-recall.mjs",
    "joy:report": "node -e \"import('./server/services/joyStabilityService.js').then(m=>m.sendWeeklyReport({force:true}).then(r=>console.log(r)))\""
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.3.39",
    "@capgo/capacitor-updater": "^8.51.3",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@hwagfu/cursor": "^1.2.1",
    "@iconify/react": "^6.0.2",
    "@liquidglass/react": "^0.1.3",
    "@nkzw/liquid-glass": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@sentry/react": "^10.70.0",
    "@simplewebauthn/browser": "^10.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@use-gesture/react": "^10.3.1",
    "border-beam": "^1.4.1",
    "bot-avatars": "^0.2.2",
    "canvas-confetti": "^1.9.4",
    "chess.js": "^1.4.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.4.2",
    "hls.js": "^1.6.16",
    "hugo-music": "^0.2.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "img-fx": "^0.5.1",
    "jsbarcode": "^3.12.3",
    "liquid-gooey": "^0.2.2",
    "lucide-react": "^1.23.0",
    "metal-fx": "^2.0.11",
    "motion": "^12.43.0",
    "p-limit": "^7.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "^9.15.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "simple-icons": "^16.31.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.1.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
