{
  "name": "hugo-wishpax-portal",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "cd server && PORT=${PORT:-8099} npm run dev",
    "dev:backend:watch": "cd server && PORT=${PORT:-8099} npm run dev",
    "build": "vite build && node scripts/generate-seo.mjs",
    "build:analyze": "ANALYZE=1 vite build",
    "check:seo": "node scripts/check-seo.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "ci:seo": "npm run build && npm run check:seo",
    "ci:performance": "npm run build && npm run check:performance",
    "lint": "eslint src",
    "preview": "vite preview",
    "server:install": "cd server && npm install",
    "setup": "npm install && npm run server:install",
    "check:api-auth": "node scripts/check-api-auth.mjs",
    "check:all": "npm run lint && npm run check:imports && npm run check:api-auth && npm run check:stock && npm run check:chart && npm run build && npm run check:seo && npm run check:performance",
    "build:native": "VITE_BUILD_TARGET=native vite build --outDir dist-native",
    "native:sync": "VITE_API_URL=https://api.hugowishpax.studio/api npm run build:native && npx cap sync",
    "native:ios": "npm run native:sync && npx cap open ios",
    "native:android": "npm run native:sync && npx cap open android",
    "cv:pdf": "npm run cv:pdf:vi && npm run cv:pdf:en",
    "cv:pdf:vi": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --no-pdf-header-footer --print-to-pdf=public/cv-le-gia-huy.pdf \"file://$PWD/docs/cv.html?lang=vi\"",
    "cv:pdf:en": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --no-pdf-header-footer --print-to-pdf=public/cv-le-gia-huy-en.pdf \"file://$PWD/docs/cv.html?lang=en\"",
    "check:imports": "node scripts/check-tracked-imports.mjs",
    "check:stock": "node server/scripts/check-stock-market.mjs && node server/scripts/check-stock-trade.mjs",
    "check:chart": "node server/scripts/check-invest-chart.mjs",
    "ota:bundle": "node scripts/ota-bundle.mjs",
    "dev:frontend": "vite",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.3.39",
    "@capgo/capacitor-updater": "^8.51.3",
    "@hwagfu/cursor": "^1.2.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@simplewebauthn/browser": "^10.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@use-gesture/react": "^10.3.1",
    "canvas-confetti": "^1.9.4",
    "chess.js": "^1.4.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.4.2",
    "hls.js": "^1.6.16",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.43.0",
    "p-limit": "^7.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.2",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "svgo": "^4.0.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
