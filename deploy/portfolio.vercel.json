{
  "buildCommand": "npm run build:portfolio",
  "outputDirectory": "dist-portfolio",
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/:path*",
      "destination": "https://www.hugowishpax.studio/services/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/project",
      "destination": "/project/index.html"
    },
    {
      "source": "/project/hugo-studio",
      "destination": "/project/hugo-studio/index.html"
    },
    {
      "source": "/project/chanh-toa",
      "destination": "/project/chanh-toa/index.html"
    },
    {
      "source": "/project/hwj",
      "destination": "/project/hwj/index.html"
    },
    {
      "source": "/project/minh-oi-media",
      "destination": "/project/minh-oi-media/index.html"
    },
    {
      "source": "/project/l3go-coffee",
      "destination": "/project/l3go-coffee/index.html"
    },
    {
      "source": "/project/m-hike",
      "destination": "/project/m-hike/index.html"
    },
    {
      "source": "/en/",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/project",
      "destination": "/en/project/index.html"
    },
    {
      "source": "/en/project/hugo-studio",
      "destination": "/en/project/hugo-studio/index.html"
    },
    {
      "source": "/en/project/chanh-toa",
      "destination": "/en/project/chanh-toa/index.html"
    },
    {
      "source": "/en/project/hwj",
      "destination": "/en/project/hwj/index.html"
    },
    {
      "source": "/en/project/minh-oi-media",
      "destination": "/en/project/minh-oi-media/index.html"
    },
    {
      "source": "/en/project/l3go-coffee",
      "destination": "/en/project/l3go-coffee/index.html"
    },
    {
      "source": "/en/project/m-hike",
      "destination": "/en/project/m-hike/index.html"
    },
    {
      "source": "/zh/",
      "destination": "/zh/index.html"
    },
    {
      "source": "/zh/project",
      "destination": "/zh/project/index.html"
    },
    {
      "source": "/zh/project/hugo-studio",
      "destination": "/zh/project/hugo-studio/index.html"
    },
    {
      "source": "/zh/project/chanh-toa",
      "destination": "/zh/project/chanh-toa/index.html"
    },
    {
      "source": "/zh/project/hwj",
      "destination": "/zh/project/hwj/index.html"
    },
    {
      "source": "/zh/project/minh-oi-media",
      "destination": "/zh/project/minh-oi-media/index.html"
    },
    {
      "source": "/zh/project/l3go-coffee",
      "destination": "/zh/project/l3go-coffee/index.html"
    },
    {
      "source": "/zh/project/m-hike",
      "destination": "/zh/project/m-hike/index.html"
    },
    {
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'wasm-unsafe-eval' 'sha256-dt0gJjom2X4+eFoWbZ08iMe++gq7Ug+lEyyrWKEGTdY=' https://accounts.google.com https://images.dmca.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(image|favicon)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
