{
  "appId": "studio.hugowishpax.app",
  "appName": "Hugo Studio",
  "webDir": "dist-native",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0b0a0f"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "CapacitorUpdater": {
      "updateUrl": "https://api.hugowishpax.studio/api/ota/check",
      "autoUpdate": "onLaunch",
      "resetWhenUpdate": true,
      "appReadyTimeout": 10000,
      "directUpdate": false,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    }
  }
}
