# ─── Frontend (.env ở thư mục gốc) ────────────────────────────────────────
# Chỉ biến VITE_* mới tới được trình duyệt — TUYỆT ĐỐI không đặt secret ở đây,
# Vite nhồi thẳng giá trị vào bundle công khai.
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Bản native (Capacitor) không có origin chung nên phải trỏ host tuyệt đối:
# VITE_API_URL=https://api.hugowishpax.studio/api

# Ghi đè đích proxy khi chạy `npm run dev` (mặc định trỏ Node production)
# VITE_DEV_BACKEND_URL=http://localhost:8081
# VITE_WS_URL=ws://localhost:8081

# Không có VITE_AI_URL / VITE_INTERNAL_API_KEY: trình duyệt không gọi thẳng
# Python bao giờ cả, mọi thứ đi qua Node ở /api/ai/* (aiProxyRoutes.js).

# ─── Python AI server (python-ai-server/.env) ─────────────────────────────
# Phải trùng INTERNAL_API_KEY bên server/.env — Node gắn header này khi proxy.
INTERNAL_API_KEY=doi-thanh-chuoi-ngau-nhien
# Rate limit dùng chung qua Mongo; thiếu thì tự hạ xuống đếm trong RAM.
MONGODB_URI=mongodb://localhost:27017/hugo_wishpax

# Gemini là provider chính. Nhiều key thì dùng GEMINI_API_KEYS=key1,key2,key3.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEYS=
# Groq free-tier fallback, OpenAI-compatible và rất nhanh. Free tier vẫn có rate limit.
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
HUGOPSY_ALLOW_FREE_AI_FALLBACK=true
AI_PROVIDER_COOLDOWN_SECONDS=90
# OpenRouter dành cho guide/phân loại/JSON premium ngoài lâm sàng, không dùng cho chat khủng hoảng.
OPENROUTER_API_KEY=

# Pinecone Vector DB — bỏ trống thì vector_service tự tắt.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=hugo-studio-index

# ─── Node backend (server/.env) ───────────────────────────────────────────
# Xem thêm server/utils/secrets.js: thiếu JWT_SECRET / JOY_QR_SECRET /
# GOOGLE_CLIENT_ID thì production từ chối khởi động.
# MONGODB_URI=mongodb://localhost:27017/hugo_wishpax
# INTERNAL_API_KEY=  (trùng với python-ai-server/.env)
# AI_SERVER_URL=http://localhost:8000   # production: https://hugostudio-ai.vercel.app
# REDIS_URL=        # bỏ trống = chạy 1 instance; presence + WS pub/sub tự tắt
