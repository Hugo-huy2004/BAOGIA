# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/hugo_wishpax
# For MongoDB Atlas cloud:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hugo_wishpax

# Server Port
PORT=8099

# Telegram quản gia: nhận cảnh báo tức thì từ Server/UI Specialist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry runtime monitoring. Giữ sample rate bằng 0 nếu chỉ cần errors.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Sentry Service Hook gọi POST /api/ops/sentry-hook. Secret do API tạo hook trả về.
SENTRY_WEBHOOK_SECRET=

# Seer Autofix: khi có Sentry issue ID, tạo PR nhưng không merge/deploy.
SENTRY_AUTOFIX_ENABLED=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
# Ví dụ owner/repository; bỏ trống để Sentry chọn repo liên quan.
SENTRY_REPO_NAME=

# HugoOS V1: minh chứng Study → Profile. Mặc định tắt. Production còn yêu cầu
# _id thành viên trong allowlist; dùng * chỉ cho staging mở toàn bộ.
HUGO_LEARNING_EVIDENCE_V1=false
HUGO_V1_PILOT_MEMBER_IDS=

# PayOS Configuration
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# Public contact — prefer an opaque Zalo OA/share URL so the destination also
# contains no phone number. Otherwise store only AES-GCM ciphertext generated
# with this deployment's SECRET_KEY; never commit a plaintext number.
CONTACT_ZALO_URL=
CONTACT_ZALO_NUMBER_ENCRYPTED=

# Auth secrets — REQUIRED in production (server refuses to start without them)
JWT_SECRET=generate-with-openssl-rand-hex-32
JOY_QR_SECRET=generate-with-openssl-rand-hex-32
# Must match the frontend VITE_GOOGLE_CLIENT_ID (validates Google login audience)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# aud của ID token từ bản iOS (client OAuth loại iOS). Bỏ trống nếu chưa có app.
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Public browser origin used in OAuth metadata and integration links.
# Production should be the Hugo Studio web origin, without a trailing slash.
OAUTH_ISSUER=https://www.hugowishpax.studio

# Optional Python AI server provider pool
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEYS=
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
HUGOPSY_ALLOW_FREE_AI_FALLBACK=true
AI_PROVIDER_COOLDOWN_SECONDS=90
OPENROUTER_API_KEY=

# Optional Today feed providers. arXiv and localized fallback remain available
# without keys; add either provider to include current-affairs coverage.
GNEWS_API_KEY=
NEWS_API_KEY=

# One-time admin bootstrap (remove after first run)
# ADMIN_SEED_USERNAME=
# ADMIN_SEED_PASSWORD=

# --- OTA (cập nhật app không qua store) -------------------------------------
# Bốn biến này LÀ bản phát hành. Đổi OTA_VERSION = publish, xoá = gỡ,
# đặt lại giá trị cũ = rollback. Không cần deploy lại code.
# Sinh giá trị bằng: npm run ota:bundle
# OTA_URL phải trỏ static hosting (Vercel/R2) — KHÔNG phải Render, vì Render
# tính tiền bandwidth ra theo byte và bundle nặng vài MB mỗi máy.
OTA_VERSION=
OTA_URL=
OTA_CHECKSUM=
OTA_MIN_NATIVE=
