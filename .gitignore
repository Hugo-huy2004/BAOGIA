node_modules
dist
build
# Mọi biến thể .env — không chỉ mỗi ".env". Vite còn đọc .env.local và
# .env.production.local, đúng chỗ người ta hay nhét khoá thật; trước đây hai
# tệp đó không bị chặn nên chỉ cần một lần `git add -A` là khoá lên GitHub.
.env*
!.env.example
!**/.env.example
!/.env.production

# Python
__pycache__/
.venv_gif/
*.py[cod]
*$py.class
*.pyo
.python-version

# Server logs
server/error_log.txt
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
# Native (Capacitor) build output — the web deploy uses dist/
dist-native

# OTA bundles — multi-MB per release, host them, don't commit them
ota/

# Hồ sơ người dùng tải lên — KHÔNG BAO GIỜ commit. Đây là dữ liệu cá nhân
# (CV ứng viên HugoTeam), và mỗi lượt nộp mới sẽ làm repo phình thêm.
server/uploads/

# Playwright E2E
test-results/
playwright-report/
